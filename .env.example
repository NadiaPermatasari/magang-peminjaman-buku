APP_NAME="Sistem Peminjaman Buku"
APP_ENV=local
APP_KEY=
# Secure default is false (spec §35/§58). Set true only for local debugging,
# never in a production or shared environment.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peminjaman_buku
DB_USERNAME=root
DB_PASSWORD=

# --------------------------------------------------------------------
# Application-specific secrets (spec §11, §55). Generate independent,
# random values per environment — never reuse APP_KEY for these, and
# never commit real values.
# --------------------------------------------------------------------
# Keyed-HMAC key for blind-index lookups on encrypted-but-searchable
# fields (e.g. member identity_number). Generate with:
#   php artisan tinker --execute="echo base64_encode(random_bytes(32));"
BLIND_INDEX_KEY=

# Initial super-admin account, used once by SuperAdminSeeder. Leave
# SUPER_ADMIN_PASSWORD empty to have the seeder generate and print a
# random one instead of a hardcoded weak default.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# WhatsApp notification gateway (Fonnte, https://fonnte.com). Leave
# FONNTE_TOKEN empty to disable WA delivery even if the "Notifikasi WhatsApp"
# toggle in Pengaturan Aplikasi is turned on — the settings toggle controls
# whether the feature is used, this token controls whether it technically can.
FONNTE_TOKEN=
FONNTE_API_URL=https://api.fonnte.com/send

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production once served over HTTPS (spec §33) — left unset
# here so local HTTP development still works.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
